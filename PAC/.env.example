# Copy this file to .env and fill in your own values. Never commit .env.
# If OPENAI_API_KEY is empty, VLM Status = UNAVAILABLE and the pipeline
# continues with Topology / Geometry / Restoration / Bayesian only.
OPENAI_API_KEY=
# Vision-capable model name. Empty -> default in src/config.py (VLMConfig.default_model)
OPENAI_VLM_MODEL=
